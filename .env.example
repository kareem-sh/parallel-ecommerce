APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_nfr
DB_USERNAME=ecommerce
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

TELESCOPE_ENABLED=true
NFR_LOG_LEVEL=info

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Docker Compose (optional overrides — used by docker-compose.yml)
# Hostnames below are Docker service names, not 127.0.0.1
# ---------------------------------------------------------------------------
DOCKER_DB_HOST=mysql
DOCKER_REDIS_HOST=redis
DOCKER_APP_URL=http://localhost:8000
DOCKER_CACHE_STORE=redis
DOCKER_SESSION_DRIVER=redis
DOCKER_QUEUE_CONNECTION=redis
DOCKER_LOG_STACK=single,stderr
DOCKER_HTTP_PORT=8000
DOCKER_MYSQL_PORT=3306
DOCKER_REDIS_PORT=6379
DOCKER_GRAFANA_PORT=3000
DOCKER_INFLUXDB_PORT=8086
MYSQL_ROOT_PASSWORD=root_secret
K6_BASE_URL=http://nginx:80
INFLUXDB_DB=k6
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
